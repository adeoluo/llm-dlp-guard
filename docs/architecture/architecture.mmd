flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Clients([Apps and users]):::edge
        CLI["CLI<br/>scan, redact, stream"]:::edge
        Proxy["HTTP proxy<br/>/v1/chat/completions"]:::core
        Provider(["LLM provider"]):::edge
        Clients --> Proxy --> Provider ~~~ CLI
    end

    subgraph Detect["Detection (Rust)"]
        direction TB
        Prefilter["Aho-Corasick<br/>anchor prefilter"]:::core
        Regex["Regex engine<br/>29 patterns"]:::core
        Validators["Validators<br/>Luhn, IBAN, JWT"]:::control
        Tagger["CRF tagger<br/>names, addresses"]:::core
        Resolve["Overlap resolution"]:::core
        Prefilter --> Regex --> Validators ~~~ Tagger --> Resolve
    end

    subgraph Policy["Policy and redaction"]
        direction TB
        Catalog[("Catalog and<br/>tagger weights")]:::data
        Rules["Policy engine<br/>per direction"]:::control
        Vault[("Vault<br/>reversible tokens")]:::data
        Stream["Stream gate<br/>hold-back"]:::control
        Catalog ~~~ Rules --> Vault ~~~ Stream
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Decisions["Decisions<br/>text and findings"]:::obs
        Metrics["Metrics<br/>Prometheus text"]:::obs
        Bench["Benchmarks<br/>PII and secrets"]:::obs
        Decisions ~~~ Metrics ~~~ Bench
    end

    Interfaces -->|text| Detect
    Detect -->|findings| Policy
    Policy -->|decisions| Obs
