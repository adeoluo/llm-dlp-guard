# Copy to .env and adjust. Never commit .env.
# OpenAI-compatible provider the proxy forwards to (the client's Authorization header is passed through).
DLP_UPSTREAM_URL=http://127.0.0.1:8081
DLP_HOST=127.0.0.1
DLP_PORT=8080
# Optional: YAML or JSON policy, CRF tagger weights (see scripts/train_tagger.sh).
DLP_POLICY_PATH=
DLP_MODEL_PATH=
DLP_BACKEND=auto
DLP_MAX_BODY_BYTES=4194304
DLP_UPSTREAM_TIMEOUT=120
